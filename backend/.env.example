# Copy this file to .env and fill in real values. Never commit your real .env.

# Prisma SQLite database URL relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# JWT signing secret - MUST be a long random string in real environments
JWT_SECRET="replace-with-a-long-random-secret"

# JWT token expiry (e.g. 15m, 1h, 1d, 7d)
JWT_EXPIRES_IN="1d"

# Backend port
PORT=5000

# Allowed CORS origin (frontend dev server)
CORS_ORIGIN="http://localhost:5173"
# Copy this file to .env and fill in real values.
# Backend API base URL (public shop + staff APIs)
VITE_API_BASE_URL=http://localhost:5000/api

# Central WhatsApp number used for "Order Now" and "Customize" (include country code, digits only)
VITE_WHATSAPP_NUMBER=911234567890

# Frontend public host (for absolute links, e.g. image URLs in WhatsApp messages)
VITE_APP_HOST=http://localhost:5173

# Base URL where uploaded images are served (backend uploads dir)
VITE_IMG_BASE=http://localhost:5000